# Dependencies (also nested workspace copies, otherwise a local `pnpm install`
# leaks symlink farms into the image and clobbers the container node_modules)
node_modules
**/node_modules

# Build output (nested paths must be matched explicitly)
.next
**/.next
dist
**/dist
.turbo
**/.turbo
backend-runtime
*.tsbuildinfo
**/*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs
*.log

# Environment files
.env
.env.*
!.env.example

# Git
.git
.gitignore

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# IDE
.vscode
.idea
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage

# Temporary folders
tmp
temp

# Documentation
docs
*.md

# Test files
**/*.test.js
**/*.test.ts
**/*.spec.js
**/*.spec.ts
